{
  "compilerOptions": {
    "target": "ES2021",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noImplicitAny": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@/lib/puzzles/*": ["../src/lib/puzzles/*"],
      "@/lib/share/*": ["../src/lib/share/*"],
      "@/lib/utils": ["../src/lib/utils"],
      "@/lib/utils/*": ["../src/lib/utils/*"],
      "@/*": ["./*"],
      "@noble/hashes/*": ["../node_modules/@noble/hashes/*"]
    }
  },
  "include": ["**/*.ts"]
}
